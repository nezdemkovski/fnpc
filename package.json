{
  "name": "fnpc",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build --studio && bun build scripts/migrate.ts --target bun --external pg --external drizzle-orm --outfile .mastra/output/migrate.mjs",
    "start": "mastra start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "bun scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@chat-adapter/telegram": "4.35.0",
    "@date-fns/tz": "^1.5.0",
    "@mastra/auth": "1.1.2",
    "@mastra/clickhouse": "^1.12.0",
    "@mastra/core": "1.53.0",
    "@mastra/memory": "1.23.1",
    "@mastra/observability": "1.16.2",
    "@mastra/pg": "1.17.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.22.0",
    "ynab": "4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "26.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "mastra": "1.20.2",
    "typescript": "^7.0.2"
  }
}
